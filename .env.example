# Telegram Bot Token obtained from BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Super-Admin Bot Owner IDs (comma-separated Telegram User IDs for /owner access)
BOT_OWNER_IDS=123456789,987654321

# Optional Network & Timeout Settings (useful for slow connections, high latency, or proxies)
# TELEGRAM_CONNECT_TIMEOUT=30.0
# TELEGRAM_READ_TIMEOUT=30.0
# TELEGRAM_WRITE_TIMEOUT=30.0
# TELEGRAM_POOL_TIMEOUT=10.0
# TELEGRAM_GET_UPDATES_TIMEOUT=30
# TELEGRAM_BOOTSTRAP_RETRIES=5
# TELEGRAM_PROXY_URL=http://127.0.0.1:8080
